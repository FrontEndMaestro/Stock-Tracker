rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Deny everything by default — authenticated access is required for all reads/writes.
    match /{document=**} {
      allow read, write: if false;
    }

    match /warehouses/{id} {
      // Warehouse deletion is enforced in app code (blocked when stock > 0),
      // not at the rules layer — the app's deleteWarehouse() checks stockLevels
      // before calling Firestore, providing the right UX error message.
      allow read, create, update, delete: if request.auth != null;
    }

    match /products/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.totalQuantity is int
        && request.resource.data.totalQuantity >= 0;
      allow update: if request.auth != null
        && request.resource.data.totalQuantity is int
        && request.resource.data.totalQuantity >= 0;
      // Stock guard (totalQuantity > 0) is enforced in deleteProduct() app-side,
      // same trade-off as the existing warehouse delete.
      allow delete: if request.auth != null;
    }

    match /stockLevels/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 0;
    }

    match /transactions/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;

      // Transactions are an audit trail — never allow a raw rewrite of history.
      // The ONLY fields an update may touch are `deleted` (soft-delete) and
      // `editedAt` (correction timestamp). Any change to quantity, productId,
      // warehouseId, price, weight, etc. must go through the app's
      // editTransaction()/deleteTransaction() functions, which also correct
      // stockLevels/totalQuantity in the same atomic write — this rule blocks
      // any update that bypasses that and touches other fields directly.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['deleted', 'editedAt']);

      allow delete: if false; // never hard-delete, soft-delete only
    }

    match /meta/backup {
      allow read, write: if request.auth != null;
    }
  }
}
